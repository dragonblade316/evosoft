<mujoco model="rrbot_position_control">
    <compiler angle="degree" coordinate="local"/>
    <option gravity="0 0 -9.81" integrator="RK4" timestep="0.01"/>

    <worldbody>
        <light directional="true" diffuse=".8 .8 .8" pos="0 0 5" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="5 5 .1" rgba=".9 .9 .9 1"/>

        <body name="base" pos="0 0 0.1">
            <geom name="base_geom" type="cylinder" size="0.05 0.1" rgba="0.2 0.2 0.2 1"/>
            
            <body name="link1" pos="0 0 0.1">
                <joint name="joint1" type="hinge" axis="0 1 0" pos="0 0 0" range="-180 180"/>
                <geom name="link1_geom" type="cylinder" size="0.04 0.25" pos="0 0 0.25" rgba="0.8 0 0 1"/>
                
                <body name="link2" pos="0 0 0.5">
                    <joint name="joint2" type="hinge" axis="0 1 0" pos="0 0 0" range="-180 180"/>
                    <geom name="link2_geom" type="cylinder" size="0.04 0.25" pos="0 0 0.25" rgba="0 0.8 0 1"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="pos1" joint="joint1" kp="500" kv="50" ctrlrange="-180 180" forcelimited="true" forcerange="-200 200"/>
        <position name="pos2" joint="joint2" kp="300" kv="30" ctrlrange="-180 180" forcelimited="true" forcerange="-100 100"/>
    </actuator>
</mujoco>
